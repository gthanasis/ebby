# Where people reach the app. On localhost with no Google client, the app runs signed in as the admin;
# anywhere else it refuses to serve data until Google sign-in is set up.
PUBLIC_URL=http://localhost:8000
# The Google account that runs the app: made the admin on first start, and invites everyone else.
ADMIN_EMAIL=

# Google sign-in: an OAuth client (Web application) with $PUBLIC_URL/auth/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the short-lived sign-in cookie: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Encrypts everyone's uploaded keys. Back it up: without it they can't be read again.
# python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIALS_KEY=

# Enable Banking sends people back here after they approve a bank: $PUBLIC_URL/eb-callback, also added as
# an allowed redirect URL on each person's Enable Banking application.
EB_REDIRECT_URL=http://localhost:8000/eb-callback
EB_COUNTRY=GR

# Postgres: the app's role (row-level security applies to it) and the owner that runs migrations.
# Local: docker run -d --name bank-sync-pg -e POSTGRES_USER=bank_sync_owner -e POSTGRES_PASSWORD=owner -e POSTGRES_DB=bank_sync -p 55432:5432 postgres:17-alpine
# Docker Compose sets both itself.
DATABASE_URL=postgresql://bank_sync_app:app@localhost:55432/bank_sync
DATABASE_OWNER_URL=postgresql://bank_sync_owner:owner@localhost:55432/bank_sync

# Optional: the assistant and weekly read (Claude). People can also add their own key in Settings.
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace
ANTHROPIC_WORKSPACE_ID=

# Optional, instead of Google: one password for a private single-person install (any username).
APP_PASSWORD=
